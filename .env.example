ANTHROPIC_API_KEY=your_key_here
MODEL=claude-sonnet-4-6
LOG_LEVEL=INFO
LOG_FORMAT=console
HTTP_TIMEOUT=30.0
HTTP_MAX_RETRIES=3

# Breeze Connect (ICICI Direct) — real-time NSE quotes as fallback when NSE
# API is bot-blocked (eliminates the ER-01 → 15-min-delayed yfinance path).
# Run `investor breeze-login` each morning to cache the daily session token.
# BREEZE_API_KEY=your_api_key_here
# BREEZE_API_SECRET=your_api_secret_here
